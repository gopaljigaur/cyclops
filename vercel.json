{
  "installCommand": "cd website && npm ci",
  "buildCommand": "cd website && npm run build",
  "outputDirectory": "website/dist",
  "framework": "astro",
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- website examples vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "docs/**": true
    }
  }
}
